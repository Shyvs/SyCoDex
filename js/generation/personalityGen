function generatePersonality(seed) {

    let category1 =
        pickFromList(personalities, seed);

    let category2 =
        pickDifferent(
            s => pickFromList(personalities, s),
            seed + 20,
            category1
        );

    let personality1 =
        pickFromList(category1, seed + 1);

    let personality2 =
        pickFromList(category2, seed + 2);

    return `${personality1} and ${personality2}.`;

}
